# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# PyInstaller build artifacts
build/
dist/
*.manifest

# Generated word clouds - keep the curated ones under docs/gallery instead
output/*.png
output/*.jpg
output/*.svg
!output/.gitkeep

# Palettes written at runtime by the GUI (colors_YYYY-MM-DD_HH-MM-SS.json)
colors/colors_*.json

# NLTK corpora downloaded at runtime
nltk_data/

# Packaging / tooling
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
